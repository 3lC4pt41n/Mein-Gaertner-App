{
  "expo": {
    "name": "Digitaler Gärtner",
    "slug": "digitaler-gaertner",
    "scheme": "digitalergaertner",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elcaptain.digitalergaertner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Wird benötigt, um Pflanzen zu fotografieren und per KI zu erkennen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.elcaptain.digitalergaertner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/e2da4aab-3bb5-491b-b009-e3fb2b557bdc"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-updates",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2E7D32"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e2da4aab-3bb5-491b-b009-e3fb2b557bdc"
      }
    },
    "owner": "timergenthaler"
  }
}
