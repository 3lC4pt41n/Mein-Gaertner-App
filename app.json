{
  "expo": {
    "name": "FloraPilot",
    "slug": "digitaler-gaertner",
    "scheme": "digitalergaertner",
    "version": "1.4.3",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.elcaptain.digitalergaertner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Wird benötigt, um Pflanzen zu fotografieren und per KI zu erkennen.",
        "NSLocationWhenInUseUsageDescription": "Wird für Wetter-Daten und die Weltkarte der Pflanzenfunde verwendet."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.elcaptain.digitalergaertner",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e2da4aab-3bb5-491b-b009-e3fb2b557bdc",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-updates",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "softwareKeyboardLayoutMode": "resize"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2E7D32"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "digitaler-gaertner",
          "project": "react-native"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e2da4aab-3bb5-491b-b009-e3fb2b557bdc"
      }
    },
    "owner": "timergenthaler"
  }
}
