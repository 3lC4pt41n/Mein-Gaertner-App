# Supabase
# Get these from your Supabase project settings
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Edge Functions / server-side local development
# Use the new secret key, not the legacy service_role key.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# OpenAI
# Used by Edge Functions for care/context enrichment, health checks, chat, and avatar generation
# Get from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# PlantNet
# Used by Edge Functions for primary plant species recognition from scan images
# Get from https://my.plantnet.org/
PLANTNET_API_KEY=your-plantnet-key-here

# OpenWeather
# Used for location-based weather integration and weather-driven care tasks
# Get from https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-key-here

# RevenueCat (In-App Purchases)
# Required for iOS in-app purchase integration
# Get from https://dashboard.revenuecat.com
REVENUECAT_API_KEY_IOS=your-ios-api-key-here

# RevenueCat (In-App Purchases)
# Required for Android in-app purchase integration
# Get from https://dashboard.revenuecat.com
REVENUECAT_API_KEY_ANDROID=your-android-api-key-here

# Sentry (Crash Monitoring)
# DSN for @sentry/react-native — injected via app.config.js into expo.extra.sentryDsn
# Set as EAS Secret for builds: eas secret:create --name SENTRY_DSN --value "https://..."
# Get from https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
